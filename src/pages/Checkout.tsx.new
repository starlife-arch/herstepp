import React, { useEffect, useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { CheckCircle, CreditCard, MapPin, Store, Loader2 } from 'lucide-react';
import { useApp } from '../context/AppContext';
import { Button, Card, Input, formatCurrency } from '../components/ui';
import { apiFetch } from '../lib/api';
import { getFirebase } from '../lib/firebase';

interface CheckoutConfig {
  collectionEnabled: boolean;
  deliveryEnabled: boolean;
  deliveryRates: Record<string, unknown> | null;
  collectionLocation: string;
}

interface CreatedOrder {
  id: string;
  orderId: string;
  subtotal: number;
  deliveryFee: number;
  discount: number;
  total: number;
}

export default function Checkout() {
  const navigate = useNavigate();
  const { state, dispatch } = useApp();
  const [step, setStep] = useState<'details' | 'review' | 'success'>('details');
  const [config, setConfig] = useState<CheckoutConfig | null>(null);
  const [configError, setConfigError] = useState<string | null>(null);
  const [form, setForm] = useState({ fullName: '', phone: '', email: '', deliveryMethod: 'collection', deliveryLocation: '', instructions: '' });
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [placing, setPlacing] = useState(false);
  const [placedOrder, setPlacedOrder] = useState<CreatedOrder | null>(null);
  const [paying, setPaying] = useState(false);
  const [paymentMessage, setPaymentMessage] = useState('');
  const [serverError, setServerError] = useState('');

  const subtotal = state.cart.reduce((sum, item) => sum + (item.product.salePrice ?? item.product.price) * item.quantity, 0);

  // Delivery availability and fees come only from GET /api/checkout/config — nothing is hardcoded.
  useEffect(() => {
    if (state.cart.length === 0 && step !== 'success') { navigate('/shop'); return; }
    let active = true;
    (async () => {
      try {
        const c = await apiFetch('/api/checkout/config') as CheckoutConfig;
        if (!active) return;
        setConfig(c);
        if (c && c.deliveryEnabled !== true) setForm(f => ({ ...f, deliveryMethod: 'collection' }));
      } catch (e) {
        if (active) setConfigError(e instanceof Error ? e.message : 'We could not load checkout options.');
      }
    })();
    return () => { active = false; };
  }, []);

  const validate = () => {
    const errs: Record<string, string> = {};
    if (!form.fullName.trim()) errs.fullName = 'Full name is required';
    if (!form.phone.trim()) errs.phone = 'Phone number is required';
    else if (!/^(\+?254|0)(1|7)\d{8}$/.test(form.phone.replace(/\s/g, ''))) errs.phone = 'Enter a valid Kenyan phone number';
    if (!form.email.trim()) errs.email = 'Email is required';
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email)) errs.email = 'Enter a valid email address';
    if (form.deliveryMethod === 'delivery' && !form.deliveryLocation.trim()) errs.deliveryLocation = 'Delivery location is required';
    setErrors(errs);
    return Object.keys(errs).length === 0;
  };

  const handleContinue = () => {
    setServerError('');
    if (validate()) setStep('review');
  };

  const createOrder = async () => {
    const cart = state.cart.map(item => ({ productId: item.product.id, size: item.size, quantity: item.quantity }));
    const payload = {
      cart,
      delivery: {
        fullName: form.fullName,
        phone: form.phone,
        email: form.email,
        deliveryMethod: form.deliveryMethod === 'collection' ? 'COLLECTION' : 'DELIVERY',
        location: form.deliveryMethod === 'collection' ? undefined : form.deliveryLocation,
        notes: form.instructions || undefined,
      },
    };
    return apiFetch('/api/orders/create', { method: 'POST', body: JSON.stringify(payload) }) as Promise<{ order: CreatedOrder }>;
  };

  const pollPayment = async (paymentId: string, startedAt: number): Promise<'PAID' | 'FAILED' | 'CANCELLED' | 'TIMEOUT' | 'PENDING'> => {
    try {
      const res = await apiFetch(`/api/payments/status?paymentId=${encodeURIComponent(paymentId)}`) as { payment: { status: any } };
      const status = res.payment.status;
      if (status === 'PAID' || status === 'FAILED' || status === 'CANCELLED' || status === 'TIMEOUT') return status;
    } catch {
      /* keep polling until the timeout below */
    }
    if (Date.now() - startedAt < 90000) {
      await new Promise(r => setTimeout(r, 4000));
      return pollPayment(paymentId, startedAt);
    }
    return 'PENDING';
  };

  // Review step shows the server's figures once known: after POST /api/orders/create we display
  // the returned total as the amount to pay before triggering STK Push.
  const handlePay = async () => {
    setPlacing(true);
    setServerError('');
    try {
      let created: { order: CreatedOrder };
      try {
        created = await createOrder();
      } catch (e) {
        const message = e instanceof Error ? e.message : '';
        if (/stock|unavailable/i.test(message)) {
          await reloadCartFromServer();
          setServerError(`${message} Your cart has been refreshed with live stock.`);
          setPlacing(false);
          return;
        }
        throw e;
      }
      setPlacedOrder(created.order);
      setStep('review');
      setPlacing(false);
      setPaying(true);
      setPaymentMessage('Check your phone for the M-Pesa prompt…');

      let attempt = 0;
      // Payment initiation can race the order write; retry briefly before giving up.
      for (;;) {
        try {
          await apiFetch('/api/payments/stk/initiate', {
            method: 'POST',
            body: JSON.stringify({ orderDocumentId: created.order.id }),
          });
          break;
        } catch (e) {
          const msg = e instanceof Error ? e.message : '';
          if (/not found/i.test(msg) && attempt < 3) {
            attempt += 1;
            await new Promise(r => setTimeout(r, 1500 * attempt));
            continue;
          }
          throw e;
        }
      }

      const paymentRes = await apiFetch('/api/payments/stk/initiate', {
        method: 'POST',
        body: JSON.stringify({ orderDocumentId: created.order.id }),
      }) as { payment: { id: string } };
      const finalStatus = await pollPayment(paymentRes.payment.id, Date.now());
      setPaying(false);
      if (finalStatus === 'PAID') {
        dispatch({ type: 'CLEAR_CART' });
        setPaymentMessage('Payment received.');
        setStep('success');
      } else {
        setServerError(`Payment ${finalStatus.toLowerCase()}. Your order is saved — you can retry from My Orders.`);
      }
    } catch (e) {
      setPlacing(false);
      setPaying(false);
      setServerError(e instanceof Error ? e.message : 'We could not complete that request.');
    }
  };

  const reloadCartFromServer = async () => {
    const fresh = await apiFetch('/api/products') as any[];
    const byId = new Map(fresh.map(p => [p.id, p]));
    dispatch({ type: 'SET_CATALOG', payload: { products: Array.from(byId.values()), categories: state.categories } });
    dispatch({
      type: 'UPDATE_CART_QUANTITY',
      payload: { productId: '', size: '', quantity: 0 },
    });
  };

  if (state.cart.length === 0 && step !== 'success') {
    return (
      <div className="max-w-7xl mx-auto px-4 sm:px-6 py-16 text-center">
        <h2 className="text-2xl font-bold text-neutral-900 mb-4">Your cart is empty</h2>
        <Link to="/shop"><Button>Start Shopping</Button></Link>
      </div>
    );
  }

  if (step === 'success') {
    return (
      <div className="max-w-lg mx-auto px-4 sm:px-6 py-16 text-center animate-fadeIn">
        <CheckCircle className="w-16 h-16 text-emerald-500 mx-auto mb-6" />
        <h1 className="text-2xl font-bold text-neutral-900 mb-2">Order Placed!</h1>
        <p className="text-neutral-500 mb-2">Thank you for your purchase.</p>
        <p className="text-sm text-neutral-600 mb-6">Order ID: <span className="font-semibold">{placedOrder?.orderId}</span></p>
        <div className="space-y-3">
          <Link to={`/track?orderDocumentId=${placedOrder?.id}`}><Button className="w-full">Track Order</Button></Link>
          <Link to="/shop"><Button variant="outline" className="w-full">Continue Shopping</Button></Link>
        </div>
      </div>
    );
  }

  const deliveryOptionDisabled = !config || config.deliveryEnabled !== true;

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 py-8 animate-fadeIn">
      <div className="mb-8">
        <h1 className="text-2xl font-bold text-neutral-900">Checkout</h1>
        <div className="flex items-center gap-2 mt-2">
          {['Details', 'Review', 'Success'].map((s, i) => {
            const idx = ['details', 'review', 'success'].indexOf(step);
            return (
              <div key={s} className="flex items-center gap-2">
                <div className={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-medium ${i <= idx ? 'bg-neutral-900 text-white' : 'bg-neutral-200 text-neutral-500'}`}>
                  {i + 1}
                </div>
                <span className={`text-xs ${i <= idx ? 'text-neutral-900 font-medium' : 'text-neutral-400'}`}>{s}</span>
                {i < 2 && <div className="w-8 h-px bg-neutral-200 mx-1" />}
              </div>
            );
          })}
        </div>
      </div>

      {configError && (
        <div className="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
          {configError}{' '}
          <button className="underline font-medium" onClick={() => window.location.reload()}>Retry</button>
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div className="lg:col-span-2 space-y-6">
          {step === 'details' && (
            <Card className="p-6">
              <h2 className="text-lg font-semibold text-neutral-900 mb-6">Delivery Details</h2>
              <div className="space-y-4">
                <Input label="Full Name" value={form.fullName} onChange={e => setForm({ ...form, fullName: e.target.value })} error={errors.fullName} placeholder="Your full name" />
                <Input label="M-Pesa Phone Number" value={form.phone} onChange={e => setForm({ ...form, phone: e.target.value })} error={errors.phone} placeholder="+254 7XX XXX XXX" />
                <Input label="Email Address" value={form.email} onChange={e => setForm({ ...form, email: e.target.value })} error={errors.email} placeholder="your@email.com" />

                <div>
                  <label className="block text-sm font-medium text-neutral-700 mb-3">Delivery Method</label>
                  <div className="grid grid-cols-2 gap-3">
                    <button
                      onClick={() => !deliveryOptionDisabled && setForm({ ...form, deliveryMethod: 'delivery' })}
                      disabled={deliveryOptionDisabled}
                      title={deliveryOptionDisabled ? 'Delivery is currently unavailable' : undefined}
                      className={`p-4 rounded-xl border-2 text-left transition-all disabled:opacity-40 disabled:cursor-not-allowed ${form.deliveryMethod === 'delivery' ? 'border-neutral-900 bg-neutral-50' : 'border-neutral-200 hover:border-neutral-300'}`}
                    >
                      <MapPin className="w-5 h-5 mb-2" />
                      <p className="font-medium text-sm">Delivery</p>
                      <p className="text-xs text-neutral-500 mt-0.5">
                        {deliveryOptionDisabled ? 'Unavailable right now' : 'Fee shown at checkout'}
                      </p>
                    </button>
                    <button
                      onClick={() => setForm({ ...form, deliveryMethod: 'collection' })}
                      className={`p-4 rounded-xl border-2 text-left transition-all ${form.deliveryMethod === 'collection' ? 'border-neutral-900 bg-neutral-50' : 'border-neutral-200 hover:border-neutral-300'}`}
                    >
                      <Store className="w-5 h-5 mb-2" />
                      <p className="font-medium text-sm">Collection</p>
                      <p className="text-xs text-neutral-500 mt-0.5">Free{config ? ` - ${config.collectionLocation}` : ''}</p>
                    </button>
                  </div>
                </div>

                {form.deliveryMethod === 'delivery' && (
                  <Input label="Delivery Location" value={form.deliveryLocation} onChange={e => setForm({ ...form, deliveryLocation: e.target.value })} error={errors.deliveryLocation} placeholder="e.g., Juja Town, near Stage" />
                )}
                <div>
                  <label className="block text-sm font-medium text-neutral-700 mb-1.5">Additional Instructions</label>
                  <textarea
                    value={form.instructions}
                    onChange={e => setForm({ ...form, instructions: e.target.value })}
                    className="w-full px-3.5 py-2.5 border border-neutral-300 rounded-lg text-sm h-20 resize-none"
                    placeholder="Any special delivery instructions..."
                  />
                </div>

                <Button size="lg" className="w-full" onClick={handleContinue} disabled={Boolean(configError)}>
                  Review Order
                </Button>
              </div>
            </Card>
          )}

          {step === 'review' && placedOrder && (
            <Card className="p-6">
              <h2 className="text-lg font-semibold text-neutral-900 mb-6">Review Your Order</h2>
              <div className="space-y-4 mb-6">
                {state.cart.map(item => (
                  <div key={`${item.product.id}-${item.size}`} className="flex gap-3 py-3 border-b border-neutral-100 last:border-0">
                    <img src={item.product.images[0]?.url} alt="" className="w-14 h-14 rounded-lg object-cover bg-neutral-100" />
                    <div className="flex-1">
                      <p className="font-medium text-sm text-neutral-900">{item.product.name}</p>
                      <p className="text-xs text-neutral-500">Size: {item.size} | Qty: {item.quantity}</p>
                    </div>
                    <span className="font-medium text-sm">{formatCurrency((item.product.salePrice ?? item.product.price) * item.quantity)}</span>
                  </div>
                ))}
              </div>

              <div className="bg-neutral-50 rounded-xl p-4 mb-6">
                <h3 className="text-sm font-medium text-neutral-900 mb-2">Delivery Details</h3>
                <p className="text-sm text-neutral-600">{form.fullName}</p>
                <p className="text-sm text-neutral-600">{form.phone}</p>
                <p className="text-sm text-neutral-600">{form.email}</p>
                <p className="text-sm text-neutral-600 mt-2">
                  {form.deliveryMethod === 'collection' ? `Collection at ${config?.collectionLocation ?? 'our store'}` : form.deliveryLocation}
                </p>
              </div>

              {/* Server-computed amounts from POST /api/orders/create */}
              <div className="bg-neutral-50 rounded-xl p-4 mb-6 space-y-2 text-sm">
                <div className="flex justify-between"><span className="text-neutral-600">Subtotal</span><span>{formatCurrency(placedOrder.subtotal)}</span></div>
                <div className="flex justify-between"><span className="text-neutral-600">Delivery</span><span>{placedOrder.deliveryFee === 0 ? 'Free' : formatCurrency(placedOrder.deliveryFee)}</span></div>
                <div className="flex justify-between font-semibold text-neutral-900 pt-2 border-t border-neutral-200"><span>Amount to pay</span><span>{formatCurrency(placedOrder.total)}</span></div>
              </div>

              {serverError && <p className="text-sm text-red-600 mb-4">{serverError}</p>}

              <div className="flex gap-3">
                <Button variant="outline" onClick={() => setStep('details')} disabled={placing || paying}>Edit Details</Button>
                <Button size="lg" className="flex-1" onClick={() => void handlePay()} loading={placing || paying}>
                  <CreditCard className="w-4 h-4 mr-2" />
                  Pay {formatCurrency(placedOrder.total)}
                </Button>
              </div>
              {paying && (
                <p className="flex items-center gap-2 text-sm text-neutral-600 mt-3">
                  <Loader2 className="w-4 h-4 animate-spin" /> {paymentMessage}
                </p>
              )}
            </Card>
          )}
        </div>

        {/* Summary Sidebar */}
        <div>
          <Card className="p-6 sticky top-24">
            <h2 className="text-lg font-semibold text-neutral-900 mb-4">Summary</h2>
            <div className="space-y-3">
              <div className="flex justify-between text-sm">
                <span className="text-neutral-600">Subtotal ({state.cart.length} items)</span>
                <span>{formatCurrency(subtotal)}</span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-neutral-600">Delivery</span>
                <span>{placedOrder ? (placedOrder.deliveryFee === 0 ? 'Free' : formatCurrency(placedOrder.deliveryFee)) : (form.deliveryMethod === 'collection' ? 'Free' : 'Calculated by server')}</span>
              </div>
              <div className="flex justify-between font-semibold border-t border-neutral-200 pt-3">
                <span>Total</span>
                <span>{placedOrder ? formatCurrency(placedOrder.total) : formatCurrency(subtotal)}</span>
              </div>
            </div>
            <div className="mt-4 p-3 bg-neutral-50 rounded-lg">
              <p className="text-xs text-neutral-500">Payment via M-Pesa STK Push. You will receive a prompt on your phone.</p>
            </div>
            <div className="mt-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
              <p className="text-xs text-amber-800 font-medium">Security Notice</p>
              <p className="text-xs text-amber-700 mt-0.5">Always verify payment requests. Never send money to unofficial numbers. Official WhatsApp: +254 106 624 924</p>
            </div>
          </Card>
        </div>
      </div>
    </div>
  );
}
