{
  "rewrites": [
    {
      "source": "/api/firebase-config",
      "destination": "/api/catalog?route=firebase-config"
    },
    {
      "source": "/api/health",
      "destination": "/api/catalog?route=health"
    },
    {
      "source": "/api/auth/sync-profile",
      "destination": "/api/users?route=auth/sync-profile"
    },
    {
      "source": "/api/products",
      "destination": "/api/catalog?route=products"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/catalog?route=product-detail&id=:id"
    },
    {
      "source": "/api/categories",
      "destination": "/api/catalog?route=categories"
    },
    {
      "source": "/api/admin/products",
      "destination": "/api/admin?route=products"
    },
    {
      "source": "/api/admin/products/:id",
      "destination": "/api/admin?route=product-update&id=:id"
    },
    {
      "source": "/api/admin/products/:id/archive",
      "destination": "/api/admin?route=product-archive&id=:id"
    },
    {
      "source": "/api/admin/categories",
      "destination": "/api/admin?route=categories"
    },
    {
      "source": "/api/media/sign-upload",
      "destination": "/api/admin?route=media/sign-upload"
    },
    {
      "source": "/api/orders/track",
      "destination": "/api/orders?route=track"
    },
    {
      "source": "/api/dashboard",
      "destination": "/api/users?route=dashboard"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/users?route=notifications"
    },
    {
      "source": "/api/notifications/:id",
      "destination": "/api/users?route=notifications&id=:id"
    },
    {
      "source": "/api/admin/orders",
      "destination": "/api/admin?route=orders"
    },
    {
      "source": "/api/orders/create",
      "destination": "/api/orders?route=create"
    },
    {
      "source": "/api/checkout/config",
      "destination": "/api/orders?route=config"
    },
    {
      "source": "/api/payments/stk/initiate",
      "destination": "/api/payments?route=stk/initiate"
    },
    {
      "source": "/api/payments/status",
      "destination": "/api/payments?route=status"
    },
    {
      "source": "/api/payments/mpesa/callback",
      "destination": "/api/payments?route=mpesa/callback"
    },
    {
      "source": "/api/payments/receipt",
      "destination": "/api/payments?route=receipt"
    },
    {
      "source": "/api/admin/customers",
      "destination": "/api/admin?route=customers"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}