FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PRINTPAY_API_KEY=
PRINTPAY_API_BASE_URL=https://printpay.site/api
BREVO_API_KEY=
BREVO_SENDER_HELLO=
BREVO_SENDER_SUPPORT=
BREVO_SENDER_ORDERS=
BREVO_SENDER_PAYMENTS=
BREVO_SENDER_PROMOTIONS=
# REQUIRED for the 6-digit email-verification codes (POST /api/auth/verify/send).
# There is NO fallback sender for this purpose: while it is empty, /verify/send
# answers 503 "Verification emails are not configured yet." and the admin
# Notifications page lists it as missing.
BREVO_SENDER_VERIFY=
# OPTIONAL. Sender for the tip thank-you email (purpose 'tips'). When empty it
# falls back to BREVO_SENDER_PAYMENTS, so tips emails never break. The admin
# Notifications status page shows BREVO_SENDER_TIPS as optional.
BREVO_SENDER_TIPS=
# OPTIONAL. Sender for the invoice-style payment email (purpose 'invoices').
# When empty it falls back to BREVO_SENDER_PAYMENTS, so invoices never break.
# The admin Notifications status page shows BREVO_SENDER_INVOICES as optional.
BREVO_SENDER_INVOICES=
BREVO_SENDER_NAME=HerStep Collection
BREVO_REPLY_TO_EMAIL=
# OPTIONAL. The HMAC key for verification codes is normally DERIVED from
# FIREBASE_ADMIN_PRIVATE_KEY (HKDF-SHA256, salt 'herstep-verify-salt', info
# 'email-verify-code-v1') so nothing new has to be provisioned. If you set
# VERIFY_CODE_SECRET it is used instead (e.g. after rotating the Firebase key).
VERIFY_CODE_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=https://herstepcollection.shop

# AI bulk shoe uploader (server-side only)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
