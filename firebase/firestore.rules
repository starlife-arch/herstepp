rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && userData().role in ['ADMIN', 'SUPER_ADMIN']; }
    function isSuperAdmin() { return signedIn() && userData().role == 'SUPER_ADMIN'; }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'CUSTOMER' && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'deliveryDetails', 'marketingConsent', 'updatedAt']);
      allow update: if isSuperAdmin();
      allow delete: if false;
    }
    match /products/{productId} { allow read: if resource.data.status == 'ACTIVE' || isAdmin(); allow write: if false; }
    match /categories/{categoryId} { allow read: if true; allow write: if false; }
    match /settings/announcement { allow read: if resource.data.enabled == true || isAdmin(); allow write: if false; }
    match /settings/{settingId} { allow read, write: if isAdmin(); }
    match /orders/{orderId} { allow read: if isOwner(resource.data.customerId) || isAdmin(); allow write: if false; }
    match /orderItems/{itemId} { allow read: if isOwner(resource.data.customerId) || isAdmin(); allow write: if false; }
    match /payments/{paymentId} { allow read: if isOwner(resource.data.customerId) || isAdmin(); allow write: if false; }
    match /paymentTransactions/{transactionId} { allow read: if isAdmin(); allow write: if false; }
    match /orderStatusHistory/{historyId} { allow read: if isOwner(resource.data.customerId) || isAdmin(); allow write: if false; }
    match /inventoryLogs/{logId} { allow read: if isAdmin(); allow write: if false; }
    match /auditLogs/{logId} { allow read: if isAdmin(); allow write: if false; }
    match /promotions/{promotionId} { allow read: if (resource.data.active == true && resource.data.startsAt <= request.time && resource.data.endsAt >= request.time) || isAdmin(); allow write: if false; }
    match /promoCodes/{codeId} { allow read, write: if false; }
    match /promoCodeUsages/{usageId} { allow read, write: if false; }
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow update: if isOwner(resource.data.customerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }
    match /supportTickets/{ticketId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create, update, delete: if false;
      match /messages/{messageId} { allow read: if isOwner(get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId) || isAdmin(); allow write: if false; }
      match /history/{historyId} { allow read: if isAdmin(); allow write: if false; }
      match /internalNotes/{noteId} { allow read: if isAdmin(); allow write: if false; }
    }
    match /supportMessages/{messageId} { allow read, write: if false; }
    match /discountRequests/{requestId} { allow read: if isOwner(resource.data.customerId) || isAdmin(); allow write: if false; match /history/{historyId} { allow read: if isAdmin(); allow write: if false; } }
    match /bulkOrderRequests/{requestId} { allow read: if isOwner(resource.data.customerId) || isAdmin(); allow write: if false; match /history/{historyId} { allow read: if isAdmin(); allow write: if false; } }
    match /productRequests/{requestId} { allow read, write: if false; }
    match /adminUsers/{adminId} { allow read: if isSuperAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
